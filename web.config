<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS (SmarterASP). One canonical host: www and http both redirect to https://rodrigosoria.eu (both answered 200 before 02/11/2026, duplicating every page). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect www to apex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.rodrigosoria\.eu$" />
          </conditions>
          <action type="Redirect" url="https://rodrigosoria.eu/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Redirect http to https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://rodrigosoria.eu/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
